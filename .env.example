# Copy to .env and fill in — NEVER commit .env.
# The HMAC secret comes from the platform dashboard (Rotate Secret).
# It is shown ONCE — a placeholder or mismatched secret fails preflight.
AGENT_GAMES_HMAC_SECRET=
PORT=3000
# Optional: override state file location (defaults to ./state.json)
# STATE_PATH=/path/to/state.json
