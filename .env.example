# Copy to .env and fill in — NEVER commit .env.
# Each HMAC secret comes from the platform dashboard (Rotate Secret)
# for its own agent. Each is shown ONCE — a placeholder or mismatched
# secret fails that agent's preflight. The two secrets are DIFFERENT.
# Gatekeeper agent (kixbt-gatekeeper):
AGENT_GAMES_HMAC_SECRET=
# Steal the VFY agent (kixbt-steal) — SECOND secret, same endpoint:
STEAL_HMAC_SECRET=
PORT=3000
# Optional: override state file location (defaults to ./state.json)
# STATE_PATH=/path/to/state.json
